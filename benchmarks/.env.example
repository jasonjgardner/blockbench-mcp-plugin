# Copy to benchmarks/.env (git-ignored) or set in your shell. Never commit real values.

# Needed only for Replicate models (suite.json, suite.budget.json).
REPLICATE_API_TOKEN=

# Blockbench MCP endpoint; this is the default.
BLOCKBENCH_MCP_URL=http://localhost:3000/bb-mcp

# Checkout with the Blockbench skills and agent definitions; defaults to the sibling
# ../blockbench-mcp-project/blockbench-mcp-project.
BLOCKBENCH_PROJECT_ROOT=
