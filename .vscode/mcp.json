{
	"servers": {
		"blockbench": {
			"url": "http://localhost:3000/bb-mcp",
			"type": "http",
			"dev": {
				"watch": "src/**/*.ts",
			}
		},
		"bbmodel": {
			"command": "bunx",
			"args": [
				"github:jasonjgardner/blockbench-mcp-plugin",
				"--root",
				"${input:rootDir}"
			]
		}
	},
	"inputs": [
		{
			"id": "rootDir",
			"type": "promptString",
			"description": "Root directory for headless Blockbench models",
			"default": "./artifacts"
		}
	]
}